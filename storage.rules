rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos. Anyone signed in can view (friends see each other's
    // avatars); only the owner can upload or replace their own, capped at 5 MB
    // and restricted to image content.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Workout check-in photos. The owner uploads (images only, under 8 MB)
    // and can delete; the createCheckIn Cloud Function shares them with
    // friends through a download link. Reading through the SDK (including
    // fetching a download URL) is limited to the owner and their accepted
    // friends, matching posts/{postId} in firestore.rules. The friend check
    // reads Firestore, so the Storage service agent needs the
    // firebaserules.firestoreServiceAgent role (granted once per project).
    match /checkins/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || firestore.exists(/databases/(default)/documents/friendships/$(uid)/friends/$(request.auth.uid)));
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 8 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
