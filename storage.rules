rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos. Anyone signed in can view (friends see each other's
    // avatars); only the owner can upload or replace their own, capped at 5 MB
    // and restricted to image content.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Workout check-in photos. The owner uploads (images only, under 8 MB)
    // and can delete; the createCheckIn Cloud Function shares them with
    // friends through a download link.
    match /checkins/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 8 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
