rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Gamification fields (xp, streakCount, longestStreak, level,
    // lastWorkoutDate, activeDate/activeDayMinutes (today's running total
    // toward the 30-minute streak day), and the timeZone/timeZoneUpdatedAt
    // streak days are counted in) are only
    // ever written by the completeWorkout Cloud Function, which runs with
    // Admin SDK privileges and bypasses these rules entirely. The client can
    // create its own initial profile (with zeroed-out gamification fields)
    // and can freely update everything else (name, goals, etc.), but can
    // never move its own xp/streak/level directly — that's the whole point
    // of moving this server-side: a raw Firestore write can't spoof a streak.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.xp == 0
        && request.resource.data.streakCount == 0
        && request.resource.data.level == 1
        && request.resource.data.lastWorkoutDate == null
        && request.resource.data.get('timeZone', null) == null
        && request.resource.data.get('timeZoneUpdatedAt', null) == null
        && request.resource.data.get('longestStreak', null) == null
        && request.resource.data.get('activeDate', null) == null
        && request.resource.data.get('activeDayMinutes', null) == null
        && request.resource.data.friendCount == 0;

      allow update: if isOwner(uid)
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.streakCount == resource.data.streakCount
        && request.resource.data.level == resource.data.level
        && request.resource.data.lastWorkoutDate == resource.data.lastWorkoutDate
        && request.resource.data.get('timeZone', null) == resource.data.get('timeZone', null)
        && request.resource.data.get('timeZoneUpdatedAt', null) == resource.data.get('timeZoneUpdatedAt', null)
        && request.resource.data.get('longestStreak', null) == resource.data.get('longestStreak', null)
        && request.resource.data.get('activeDate', null) == resource.data.get('activeDate', null)
        && request.resource.data.get('activeDayMinutes', null) == resource.data.get('activeDayMinutes', null)
        && request.resource.data.friendCount == resource.data.friendCount
        // Changed only through the changeUsername Cloud Function, which
        // keeps the usernames/{name} claims in step.
        && request.resource.data.username == resource.data.username;

      allow delete: if false;

      // Badges are granted only by the Cloud Function.
      match /badges/{badgeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // A user's own free-text notes per exercise (seat heights, machine
      // settings). Private to the owner; one short text field per exercise.
      match /exerciseNotes/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['text', 'exerciseName', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
      }

      // User-entered BMI / body-fat history — stays client-writable.
      match /metrics/{metricId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Preset/quick-start workouts are seeded by an admin script (bypasses
    // rules via the Admin SDK) and are read-only from the client.
    match /workoutTemplates/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A user's own custom-built workouts.
    match /userWorkouts/{uid}/customWorkouts/{workoutId} {
      allow read, write: if isOwner(uid);
    }

    // A user's own completed-workout history — written only by the
    // completeWorkout Cloud Function, so xpEarned/streakBonusEarned on a log
    // can't be forged either.
    match /workoutLogs/{uid}/logs/{logId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Username -> uid lookup, claimed once at profile creation (client-side,
    // since profile creation itself is a client write). Every later change
    // goes through the changeUsername Cloud Function, which keeps this in
    // step with users/{uid}.username — so once a profile exists, a direct
    // client create here would only squat an extra, orphaned name, never
    // become the user's actual username. Blocked by denying create once
    // users/{uid} already exists.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Friend relationships are mutual (both sides written at once), which a
    // single user's own auth can't do under normal ownership rules — so
    // these are written only by the addFriend Cloud Function.
    match /friendships/{uid}/friends/{friendUid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // A user's friend activity feed — fanned out by the completeWorkout
    // Cloud Function when a friend finishes a workout, earns a badge, or
    // hits a streak milestone.
    match /activityFeed/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Verification codes for email sign-up — written and read only by the
    // sendVerificationCode/verifyEmailCode Cloud Functions. A client that
    // could read this could just look up its own code instead of checking
    // its email, and a client that could write it could self-verify.
    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }

    // In-app bug/feedback reports (floating report button, any screen). A
    // user can file their own report but can't read any back — triage
    // (reviewing, filing a Jira ticket, flipping status) happens server-side
    // via the Admin SDK, which bypasses these rules entirely. Once filed, a
    // report is immutable from the client (no editing/deleting your own
    // report after the fact).
    match /bugReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
    }

    // WHOOP (and future wearable) OAuth access/refresh tokens — never
    // exposed to the client. Written only by the exchangeWhoopCode /
    // syncWhoopData / disconnectWhoop Cloud Functions via the Admin SDK,
    // which bypasses these rules entirely.
    match /wearableTokens/{uid} {
      allow read, write: if false;
    }

    // Non-sensitive connection status + latest synced snapshot (recovery
    // score, HRV, resting HR, sleep performance, day strain) — safe for the
    // owner to read for display, but only ever written by the same Cloud
    // Functions above, so a raw client write can't fake a connection or
    // spoof wearable data (same pattern as xp/streakCount on users/{uid}).
    match /wearableSnapshots/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Lifetime totals and personal bests behind badges. The owner can read
    // them (to show progress toward a badge); only the completeWorkout and
    // deleteWorkoutLog Cloud Functions write them.
    match /userStats/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // People a user has blocked: the owner can list them (to unblock);
    // only the blockUser/unblockUser Cloud Functions write them.
    match /blocks/{uid}/blocked/{otherUid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Reports about other users. Filed and read only by Cloud Functions.
    match /userReports/{reportId} {
      allow read, write: if false;
    }

    // Friend requests: incoming (sent to you) and outgoing (you sent).
    // Owner reads; only the addFriend/respondFriendRequest/cancelFriendRequest
    // Cloud Functions write.
    match /friendRequests/{uid}/{box}/{otherUid} {
      allow read: if isOwner(uid) && (box == 'incoming' || box == 'outgoing');
      allow write: if false;
    }

    // Posts (workouts and check-in photos) and their comments. Visible to the
    // author and the author's friends; written only by Cloud Functions.
    function canSeePostBy(authorUid) {
      return request.auth != null
        && (request.auth.uid == authorUid
            || exists(/databases/$(database)/documents/friendships/$(authorUid)/friends/$(request.auth.uid)));
    }
    match /posts/{postId} {
      allow read: if canSeePostBy(resource.data.authorUid);
      allow write: if false;

      match /comments/{commentId} {
        allow read: if canSeePostBy(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid);
        allow write: if false;
      }
    }

    // Everything else is denied until its collection is built (build steps 9+)
    // and gets its own explicit rule here.
  }
}
